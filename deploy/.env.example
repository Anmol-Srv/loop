# Copy to deploy/.env and fill in. Never commit the filled-in copy.

# The hostname the team will use. No domain yet? <public-ip-with-dashes>.sslip.io
# resolves to the VM's IP and gets a real certificate: e.g. 13-201-4-7.sslip.io
ACP_DOMAIN=acp.example.com

# Letters and digits only — it goes into a connection URL unescaped.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional. RUST_LOG=debug for a noisy afternoon.
# RUST_LOG=info,sqlx=warn
